@model EmployeeDepartmentManagement.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<h1>Delete Employee</h1>

<h3>
    Are you sure you want to delete this employee?
</h3>

<hr />

<div>

    <p>
        <strong>Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Email:</strong>
        @Model.Email
    </p>

    <p>
        <strong>Salary:</strong>
        @Model.Salary
    </p>

    <p>
        <strong>Department:</strong>
        @Model.Department?.Name
    </p>

</div>

<br />

<form asp-action="DeleteEmployee"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit">
        Yes, Delete
    </button>

    <a asp-action="GetAll">
        Cancel
    </a>

</form>